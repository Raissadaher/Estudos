# ======================================================
# FLUXO PROFISSIONAL DE MUDANÇA AMBIENTAL
# NDVI + DETECÇÃO DE VEGETAÇÃO ARBÓREA
# ======================================================

import numpy as np
import matplotlib.pyplot as plt
import rasterio
import geopandas as gpd

from rasterio.features import shapes
from scipy.ndimage import binary_opening
from matplotlib.colors import LinearSegmentedColormap

# ======================================================
# CAMINHO DAS IMAGENS
# ======================================================

imagem_2023 = r"C:\Users\raissa.alves\Documents\projeto\landsat_2023.tif"

imagem_2024 = r"C:\Users\raissa.alves\Documents\projeto\landsat_2024.tif"

# ======================================================
# SAÍDAS
# ======================================================

saida_raster = (
    r"C:\Users\raissa.alves\Documents\projeto\mascara_ndvi.tif"
)

saida_shp = (
    r"C:\Users\raissa.alves\Documents\projeto\mudancas_ndvi.shp"
)

saida_png = (
    r"C:\Users\raissa.alves\Documents\projeto\resultado_ndvi.png"
)

saida_veg_2023 = (
    r"C:\Users\raissa.alves\Documents\projeto\vegetacao_2023.shp"
)

saida_veg_2024 = (
    r"C:\Users\raissa.alves\Documents\projeto\vegetacao_2024.shp"
)

saida_veg_perdida = (
    r"C:\Users\raissa.alves\Documents\projeto\vegetacao_perdida.shp"
)

# ======================================================
# LEITURA DAS IMAGENS
# ======================================================

print("Lendo imagens...")

with rasterio.open(imagem_2023) as src2023:

    red_2023 = src2023.read(4).astype(np.float32)
    nir_2023 = src2023.read(5).astype(np.float32)

    perfil = src2023.profile
    transform = src2023.transform
    crs = src2023.crs

with rasterio.open(imagem_2024) as src2024:

    red_2024 = src2024.read(4).astype(np.float32)
    nir_2024 = src2024.read(5).astype(np.float32)

# ======================================================
# REMOVER VALORES INVÁLIDOS
# ======================================================

red_2023[red_2023 == 0] = np.nan
nir_2023[nir_2023 == 0] = np.nan

red_2024[red_2024 == 0] = np.nan
nir_2024[nir_2024 == 0] = np.nan

# ======================================================
# NDVI
# ======================================================

print("Calculando NDVI...")

ndvi_2023 = (
    (nir_2023 - red_2023)
    / (nir_2023 + red_2023 + 0.0001)
)

ndvi_2024 = (
    (nir_2024 - red_2024)
    / (nir_2024 + red_2024 + 0.0001)
)

# ======================================================
# LIMITAR NDVI
# ======================================================

ndvi_2023 = np.clip(ndvi_2023, -1, 1)
ndvi_2024 = np.clip(ndvi_2024, -1, 1)

# ======================================================
# DIFERENÇA TEMPORAL
# ======================================================

print("Calculando diferença temporal...")

ndvi_diff = ndvi_2024 - ndvi_2023

# ======================================================
# THRESHOLD ADAPTATIVO
# ======================================================

threshold = np.nanpercentile(
    np.abs(ndvi_diff),
    90
)

print(f"Threshold: {threshold:.4f}")

# ======================================================
# DETECÇÃO DE MUDANÇA
# ======================================================

loss_mask = ndvi_diff < -threshold

gain_mask = ndvi_diff > threshold

change_mask = loss_mask | gain_mask

# ======================================================
# REMOVER RUÍDO
# ======================================================

print("Removendo ruído...")

loss_mask = binary_opening(
    loss_mask,
    structure=np.ones((2, 2))
)

gain_mask = binary_opening(
    gain_mask,
    structure=np.ones((2, 2))
)

change_mask_clean = loss_mask | gain_mask

# ======================================================
# DETECÇÃO DE VEGETAÇÃO ARBÓREA
# ======================================================

print("Detectando vegetação arbórea...")

tree_mask_2023 = ndvi_2023 > 0.45

tree_mask_2024 = ndvi_2024 > 0.45

# vegetação perdida
trees_lost = tree_mask_2023 & ~tree_mask_2024

# ======================================================
# ESTATÍSTICAS
# ======================================================

print("\n===== RESULTADOS =====")

print(
    f"Pixels alterados: "
    f"{change_mask_clean.sum():,}"
)

print(
    f"Percentual alterado: "
    f"{100 * change_mask_clean.mean():.2f}%"
)

print(
    f"Vegetação arbórea 2023: "
    f"{tree_mask_2023.sum():,}"
)

print(
    f"Vegetação arbórea 2024: "
    f"{tree_mask_2024.sum():,}"
)

print(
    f"Vegetação perdida: "
    f"{trees_lost.sum():,}"
)

# ======================================================
# EXPORTAR RASTER
# ======================================================

print("\nSalvando raster...")

perfil.update(
    dtype=rasterio.uint8,
    count=1,
    compress="lzw",
    nodata=0
)

with rasterio.open(
    saida_raster,
    "w",
    **perfil
) as dst:

    dst.write(
        change_mask_clean.astype(rasterio.uint8),
        1
    )

print("Raster salvo!")

# ======================================================
# FUNÇÃO EXPORTAR SHAPEFILE
# ======================================================

def exportar_shapefile(mask, saida):

    resultados = (
        {
            "properties": {"value": int(v)},
            "geometry": s
        }
        for s, v in shapes(
            mask.astype(np.uint8),
            mask=mask,
            transform=transform
        )
    )

    geoms = list(resultados)

    if len(geoms) == 0:

        print(f"Nenhum dado para {saida}")
        return

    gdf = gpd.GeoDataFrame.from_features(
        geoms,
        crs=crs
    )

    gdf = gdf[gdf.geometry.notnull()]

    gdf["area_m2"] = gdf.geometry.area

    gdf["area_ha"] = (
        gdf["area_m2"] / 10000
    )

    # filtro reduzido
    gdf = gdf[gdf["area_ha"] > 0.03]

    if len(gdf) > 0:

        gdf.to_file(saida)

        print(f"Shapefile salvo: {saida}")

    else:

        print(
            f"Nenhum polígono válido em {saida}"
        )

# ======================================================
# EXPORTAR SHAPEFILES
# ======================================================

print("\nExportando shapefiles...")

exportar_shapefile(
    change_mask_clean,
    saida_shp
)

exportar_shapefile(
    tree_mask_2023,
    saida_veg_2023
)

exportar_shapefile(
    tree_mask_2024,
    saida_veg_2024
)

exportar_shapefile(
    trees_lost,
    saida_veg_perdida
)

# ======================================================
# VISUALIZAÇÃO
# ======================================================

print("Gerando visualização...")

fig, axes = plt.subplots(
    1,
    5,
    figsize=(30, 7)
)

# ======================================================
# NOVA PALETA NDVI
# ======================================================

cores_ndvi = LinearSegmentedColormap.from_list(
    "ndvi_profissional",
    [
        "#3d1f0f",   # solo escuro
        "#8c510a",   # solo
        "#d8b365",   # solo claro
        "#f6e8c3",   # transição
        "#c7e9ad",   # vegetação leve
        "#74c476",   # vegetação média
        "#238b45",   # vegetação forte
        "#00441b"    # floresta densa
    ]
)

# ======================================================
# NDVI 2023
# ======================================================

img1 = axes[0].imshow(
    ndvi_2023,
    cmap=cores_ndvi,
    vmin=-0.2,
    vmax=0.9
)

axes[0].set_title("NDVI 2023")
axes[0].axis("off")

plt.colorbar(
    img1,
    ax=axes[0],
    fraction=0.046
)

# ======================================================
# NDVI 2024
# ======================================================

img2 = axes[1].imshow(
    ndvi_2024,
    cmap=cores_ndvi,
    vmin=-0.2,
    vmax=0.9
)

axes[1].set_title("NDVI 2024")
axes[1].axis("off")

plt.colorbar(
    img2,
    ax=axes[1],
    fraction=0.046
)

# ======================================================
# DIFERENÇA NDVI
# ======================================================

img3 = axes[2].imshow(
    ndvi_diff,
    cmap="seismic",
    vmin=-0.2,
    vmax=0.2
)

axes[2].set_title("Diferença NDVI")
axes[2].axis("off")

plt.colorbar(
    img3,
    ax=axes[2],
    fraction=0.046
)

# ======================================================
# MAPA DE MUDANÇA
# ======================================================

change_map = np.zeros(ndvi_diff.shape)

# perda vegetal
change_map[loss_mask] = -1

# ganho vegetal
change_map[gain_mask] = 1

img4 = axes[3].imshow(
    change_map,
    cmap="RdYlGn",
    vmin=-1,
    vmax=1
)

axes[3].set_title("Mudanças Detectadas")
axes[3].axis("off")

plt.colorbar(
    img4,
    ax=axes[3],
    fraction=0.046
)

# ======================================================
# VEGETAÇÃO PERDIDA
# ======================================================

img5 = axes[4].imshow(
    trees_lost.astype(np.uint8) * 255,
    cmap="Reds"
)

axes[4].set_title("Perda Vegetal Arbórea")
axes[4].axis("off")

plt.colorbar(
    img5,
    ax=axes[4],
    fraction=0.046
)

# ======================================================
# SALVAR FIGURA
# ======================================================

plt.tight_layout()

plt.savefig(
    saida_png,
    dpi=300,
    bbox_inches="tight"
)

print("Imagem salva!")

# ======================================================
# MOSTRAR RESULTADO
# ======================================================

plt.show()

print("\nProcessamento concluído!")
